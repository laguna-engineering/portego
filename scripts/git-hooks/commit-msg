#!/bin/sh
# Applies the same rules to the commit message, which the staged scan cannot see.
set -e
command -v gitleaks >/dev/null || {
  echo "gitleaks is not installed: https://github.com/gitleaks/gitleaks" >&2
  exit 1
}
root=$(git rev-parse --show-toplevel)
private=$(git rev-parse --absolute-git-dir)/gitleaks-private.toml

gitleaks stdin --no-banner --redact --config "$root/.gitleaks.toml" < "$1"
if [ -f "$private" ]; then
  gitleaks stdin --no-banner --redact --config "$private" < "$1"
fi
