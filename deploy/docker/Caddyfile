# One upstream serves both hostnames. The application tells them apart by the
# Host header, and the MCP transport checks it against APP_URL, so the proxy
# must pass it unchanged. reverse_proxy does by default.
{$APP_HOST}, {$CONTENT_HOST} {
	# The application sets its own security headers on previews. HSTS is the
	# one it leaves to the proxy.
	header Strict-Transport-Security "max-age=31536000"

	# An upload carries the document and its images. The limit sits above what
	# the application accepts, so an oversized upload receives its
	# FILE_TOO_LARGE JSON instead of a proxy error.
	@upload path /api/artifacts /api/uploads
	request_body @upload {
		max_size 56MiB
	}
	@other not path /api/artifacts /api/uploads
	request_body @other {
		max_size 6MiB
	}

	# Client ID Metadata Documents for MCP clients. The authorization server
	# fetches them without a session, and the application answers unknown paths
	# with index.html, so the proxy serves them.
	handle /mcp-clients/* {
		root * /srv
		file_server
	}

	# Caddy flushes text/event-stream responses as they are written and sets no
	# response timeout, so the change stream at /api/events needs no extra rule.
	handle {
		reverse_proxy app:3000
	}
}
