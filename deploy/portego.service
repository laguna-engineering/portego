[Unit]
Description=portego artifact service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=portego
Group=portego
WorkingDirectory=/srv/portego/current
EnvironmentFile=/etc/portego.env
ExecStart=/usr/local/bin/bun run dist/server/index.js
Restart=on-failure
RestartSec=2s

# Creates and owns /var/lib/portego, which DATA_DIR must point at. This
# is the only writable path the service has.
StateDirectory=portego
StateDirectoryMode=0750
UMask=0027

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_NETLINK and AF_UNIX are required by glibc name resolution, which the
# OAuth token exchange and the client metadata fetch depend on.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A blocked call returns ENOSYS instead of killing the process with SIGSYS. The
# allowlist is the set of syscall names the systemd on the host knows, so a
# syscall newer than that systemd is absent from it even when it is ordinary.
# Bun calls close_range, which an older systemd does not know: without this the
# process dies on the first such call, and with it Bun reads ENOSYS and uses
# its fallback. A privileged syscall is still refused, and still never runs.
SystemCallErrorNumber=ENOSYS

# MemoryDenyWriteExecute is deliberately absent. Bun's JIT needs writable
# executable pages and the service does not start with it set.

[Install]
WantedBy=multi-user.target
