# Copy to .env and fill in. Bun loads .env automatically.

# development | test | production
NODE_ENV=development

# Shown on the sign-in page and by the OAuth consent screen.
APP_NAME=Portego

# The server binds to the loopback address. A reverse proxy is the public
# listener.
HOST=127.0.0.1
PORT=3000

# The public origin the browser uses. OAuth callback URLs are built from it.
# Development goes through the Vite dev server, which proxies /api to Hono.
# Production: https://share.acme.example
APP_URL=http://localhost:5173

# The origin that serves artifact previews. It must be a different host from
# APP_URL: that separation is what keeps uploaded HTML away from application
# cookies. The browser treats 127.0.0.1 and localhost as different hosts.
# Production: https://content.share.acme.example
CONTENT_URL=http://127.0.0.1:5173

# Required in production. Generate one with:
#   bun -e 'console.log(crypto.randomUUID().replaceAll("-","") + crypto.randomUUID().replaceAll("-",""))'
SESSION_SECRET=

# SQLite and artifact files. Production uses /var/lib/portego.
DATA_DIR=data

# Largest upload accepted, in bytes. 5 MiB by default.
ARTIFACT_MAX_BYTES=5242880

# Directory holding the built client. Must be relative; it resolves from the
# directory `bun run start` is called from.
CLIENT_DIST=dist/client

# --- Authentication -------------------------------------------------------

# Enabled identity providers, comma separated. Known ids: google, oidc. Leave empty
# until the credentials below are filled in: sign-in is then unavailable and
# every protected route refuses the request.
AUTH_PROVIDERS=

# Who may use the service after a provider proves their identity. Set one of
# the two. An empty policy admits nobody and startup fails.
AUTH_ALLOWED_EMAIL_DOMAINS=acme.example
AUTH_ALLOW_ALL_AUTHENTICATED=false

# Let any caller register an OAuth client. Off by default: Client ID Metadata
# Documents are the supported way for an MCP client to register.
MCP_ALLOW_DYNAMIC_CLIENT_REGISTRATION=false

# Generic OpenID Connect provider, for a deployment that does not use Google.
# For local development, `bun run dev:issuer` serves one at
# http://127.0.0.1:9876 with client id and secret test-client-id and
# test-client-secret; see README.md.
# The issuer URL, or its discovery URL. Must be https outside local testing.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. Defaults to "openid profile email" and "Single sign-on".
OIDC_SCOPES=
OIDC_LABEL=

# Google OAuth client (Google Cloud console, "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace hosted domain. Enforced against the id token `hd` claim.
GOOGLE_HOSTED_DOMAIN=acme.example
